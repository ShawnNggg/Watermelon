{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watermelon",
  "version": "0.1.4",
  "identifier": "com.watermelon.widget",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "下班啦",
        "width": 340,
        "height": 380,
        "minWidth": 280,
        "minHeight": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' https://api.jiejiariapi.com asset: http://asset.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' blob: asset: http://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "下班啦 — 打工人桌面挂件",
    "createUpdaterArtifacts": true,
    "macOS": {
      "exceptionDomain": "",
      "entitlements": null,
      "frameworks": [],
      "minimumSystemVersion": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNkUzNjRGQzgyOEJCNzMKUldSenV5aklUelp1NG1EQVhBL3RXZitBSWx2LzRkZTNWZUpZNndsKzRXZGZ5N1dRaFp6dFU1RlkK",
      "endpoints": [
        "https://github.com/ShawnNggg/Watermelon/releases/latest/download/latest.json"
      ]
    }
  }
}
